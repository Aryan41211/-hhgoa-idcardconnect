# ---------------------------------------------------------------------------
# HHGOA ID Card Connect — environment configuration
# All values shown are placeholders. Never commit a real .env file.
# ---------------------------------------------------------------------------

# Port used by `npm start` in production (defaults to 3000).
# PORT=3000

# Directory where generated images + records are persisted.
# Defaults to `<project-root>/.data`. Override on hosts with an attached disk.
# DATA_DIR=.data

# Public base URL of the deployed app (used for shareable links / OG tags).
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Vercel Blob storage (swap for the filesystem store in lib/storage.ts)
# BLOB_READ_WRITE_TOKEN=

# Optional admin guard token — if set, /ids/admin requires it.
# ADMIN_TOKEN=
